# ==========================================
# MADECC Group Portal - Environment Variables Configuration
# Copy this file to '.env' and fill in the values for local development.
# ==========================================

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
# In production, Neon or Supabase PostgreSQL URLs with SSL are supported.
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=require
DIRECT_DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=require

# Google Gemini AI API Key
# Required for Virtual Assistant Chat and AI Document Workflows.
GEMINI_API_KEY=your_gemini_api_key_here

# Secret used to sign and verify CSRF protection tokens (Optional - defaults to a secure dynamic server secret if not set)
CSRF_SECRET=your_cryptographically_secure_csrf_secret_here

# Node Environment
# Values: 'development', 'production'
NODE_ENV=development

# Server Port
# Note: In the AI Studio workspace, port 3000 is required.
PORT=3000

# Application URLs & Domain Routing
# APP_URL: Current runtime container or staging host URL
APP_URL=http://localhost:3000
# PRODUCTION_URL: Official production domain for MADECC Group OAuth callbacks and external links
PRODUCTION_URL=https://madeccgroup.online
# PUBLIC_APP_URL: Public URL override (optional)
PUBLIC_APP_URL=https://madeccgroup.online

# Administrative Notification Email
ADMIN_EMAIL=kreboya603@gmail.com

# SMTP Mail Server Credentials (Optional, used for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_smtp_app_password

# Production File Storage Services (Optional - Falls back to safe container disk storage)
# Option A: Supabase Storage configuration
SUPABASE_URL=https://your_supabase_project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=your_supabase_bucket_name

# Option B: Cloudinary CDN configuration
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Centralized Meta Business Developer App Integration (Facebook Pages, Instagram Pro, WhatsApp Business)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Social Media Command Center Credentials & OAuth Integrations (Server-side secrets)
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
WHATSAPP_CLIENT_ID=your_whatsapp_client_id
WHATSAPP_CLIENT_SECRET=your_whatsapp_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
TWITTER_CLIENT_ID=your_x_client_id
TWITTER_CLIENT_SECRET=your_x_client_secret

# Encryption key for securing social platform OAuth tokens server-side
SOCIAL_TOKEN_ENCRYPTION_KEY=your_32_byte_hex_or_secret_encryption_key_here

# Dedicated Meta / Facebook App Review Tester Account Configuration
META_REVIEWER_EMAIL=meta-reviewer@madeccgroup.online
META_REVIEWER_PASSWORD=your_secure_meta_reviewer_password_here

