export type AudioExtractionFormat =
  | "mp3"
  | "wav";


export interface MediaAssetInput {
  id: string;
  name: string;
  mimeType: string;
}


export interface MediaExportRecordInput {
  mediaId: string;
  userId: string;
  format: string;
  mimeType: string;
  filename: string;
  sizeBytes: number;
}


export interface MediaExportResult {
  buffer: Buffer;
  mimeType: string;
  filename: string;
}


/**
 * Record an export.
 *
 * This function is intentionally kept behind a small adapter so the
 * media service does not contain database-specific logic.
 *
 * Replace the implementation with your existing aiMediaExports
 * database service when wiring the persistence layer.
 */
async function recordExport(
  input: MediaExportRecordInput
): Promise<void> {
  /*
   * The database persistence layer should be connected here.
   *
   * Example:
   *
   * await createMediaExport(input);
   *
   * Keeping this adapter isolated allows the media transformation
   * service to remain independent from Drizzle/database details.
   */

  void input;
}


/**
 * Extract audio from a video media asset.
 *
 * Supported output formats:
 * - mp3
 * - wav
 *
 * The source asset is supplied as an ArrayBuffer and is written
 * temporarily to the operating system's temporary directory.
 *
 * The generated audio is returned as a Buffer and the temporary
 * files are always removed in the finally block.
 */
export async function extractAudio(
  asset: MediaAssetInput,
  arrayBuffer: ArrayBuffer,
  mediaId: string,
  userId: string,
  format: AudioExtractionFormat = "mp3"
): Promise<MediaExportResult> {
  if (!asset.id) {
    throw new Error("Media asset ID is required.");
  }

  if (!asset.name) {
    throw new Error("Media asset name is required.");
  }

  if (!asset.mimeType) {
    throw new Error("Media asset MIME type is required.");
  }

  if (!userId) {
    throw new Error("User ID is required.");
  }

  if (!mediaId) {
    throw new Error("Media ID is required.");
  }

  if (!arrayBuffer || arrayBuffer.byteLength === 0) {
    throw new Error("Media input is empty.");
  }

  if (!isAllowedMimeType(asset.mimeType)) {
    throw new Error(
      `Unsupported media MIME type: ${asset.mimeType}`
    );
  }

  if (!asset.mimeType.startsWith("video/")) {
    throw new Error(
      `Audio extraction requires a video asset. Received: ${asset.mimeType}`
    );
  }

  if (
    format !== "mp3" &&
    format !== "wav"
  ) {
    throw new Error(
      `Unsupported audio output format: ${format}`
    );
  }

  const tempDirectory = await fs.mkdtemp(
    path.join(
      os.tmpdir(),
      "madecc-media-"
    )
  );

  const input = path.join(
    tempDirectory,
    `${crypto.randomUUID()}-input.${extensionFromMime(
      asset.mimeType
    )}`
  );

  const output = path.join(
    tempDirectory,
    `${crypto.randomUUID()}-output.${format}`
  );

  try {
    await fs.writeFile(
      input,
      Buffer.from(arrayBuffer)
    );

    await videoToAudio(
      input,
      output,
      format
    );

    const buffer =
      await fs.readFile(output);

    const mimeType =
      format === "mp3"
        ? "audio/mpeg"
        : "audio/wav";

    const filename =
      withExtension(
        safeFilename(
          asset.name
        ),
        format
      );

    await recordExport({
      mediaId,
      userId,
      format,
      mimeType,
      filename,
      sizeBytes: buffer.length,
    });

    return {
      buffer,
      mimeType,
      filename,
    };
  } finally {
    await fs.rm(
      tempDirectory,
      {
        recursive: true,
        force: true,
      }
    );
  }
}

/* ============================================================
   MADECC MEDIA SERVICE COMPATIBILITY EXPORTS
   Added automatically by media-system repair operation.
