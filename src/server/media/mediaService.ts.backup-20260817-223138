import {
  Document,
  Packer,
  Paragraph,
  HeadingLevel,
} from "docx";
import PDFDocument from "pdfkit";
import { eq, and } from "drizzle-orm";
function __mediaSafeFilename(value: string): string {
  return String(value || "madecc-media")
    .replace(/[^a-zA-Z0-9._-]+/g, "_")
    .replace(/^_+|_+$/g, "")
    .slice(0, 180) || "madecc-media";
}

async function __mediaGetAsset(
  mediaId: string,
  userId: string
): Promise<any> {
  const rows = await db
    .select()
    .from(aiMediaAssets)
    .where(
      and(
        eq(aiMediaAssets.id, mediaId),
        eq(aiMediaAssets.userId, userId),
        eq(aiMediaAssets.archived, false)
      )
    )
    .limit(1);

  if (!rows.length) {
    throw new Error("Media asset not found.");
  }

  return rows[0];
}

function __mediaTextContent(asset: any): string {
  const metadata = asset.metadata;

  if (metadata && typeof metadata === "object") {
    const candidate =
      metadata.content ??
      metadata.text ??
      metadata.generatedText ??
      metadata.body ??
      metadata.description;

    if (typeof candidate === "string") {
      return candidate;
    }
  }

  return String(
    asset.content ??
    asset.text ??
    asset.description ??
    asset.name ??
    ""
  );
}

async function __mediaCreateDocx(
  title: string,
  content: string
): Promise<Buffer> {
  const paragraphs = content
    .split(/\r?\n/)
    .map(
      (line: string) =>
        new Paragraph({
          text: line,
        })
    );

  const document = new Document({
    sections: [
      {
        children: [
          new Paragraph({
            text: title,
            heading: HeadingLevel.HEADING_1,
          }),
          ...paragraphs,
        ],
      },
    ],
  });

  return Packer.toBuffer(document);
}

function __mediaCreatePdf(
  title: string,
  content: string
): Promise<Buffer> {
  return new Promise(
    (resolve, reject) => {
      const chunks: Buffer[] = [];

      const doc = new PDFDocument({
        size: "A4",
        margin: 50,
        info: {
          Title: title,
          Author: "MADECC Group",
          Creator: "MADECC AI Studio",
        },
      });

      doc.on("data", (chunk: Buffer) => {
        chunks.push(Buffer.from(chunk));
      });

      doc.on("end", () => {
        resolve(Buffer.concat(chunks));
      });

      doc.on("error", reject);

      doc.fontSize(20).text(title);
      doc.moveDown();
      doc.fontSize(10).text(content, {
        align: "left",
        lineGap: 5,
      });

      doc.end();
    }
  );
}
export async function exportText(
  mediaId: string,
  userId: string,
  format: "txt" | "docx" | "pdf"
): Promise<{
  buffer: Buffer;
  mimeType: string;
  filename: string;
}> {
  const asset = await __mediaGetAsset(
    mediaId,
    userId
  );

  const title =
    String(
      asset.name ||
      asset.originalFilename ||
      "MADECC AI Media"
    );

  const content =
    __mediaTextContent(asset);

  let buffer: Buffer;
  let mimeType: string;

  if (format === "txt") {
    buffer = Buffer.from(
      content,
      "utf8"
    );
    mimeType = "text/plain; charset=utf-8";
  }
  else if (format === "docx") {
    buffer = await __mediaCreateDocx(
      title,
      content
    );
    mimeType =
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
  }
  else {
    buffer = await __mediaCreatePdf(
      title,
      content
    );
    mimeType = "application/pdf";
  }

  const filename =
    `${__mediaSafeFilename(title)}.${format}`;

  return {
    buffer,
    mimeType,
    filename,
  };
}
export async function exportAudio(
  mediaId: string,
  userId: string,
  format: "mp3" | "wav"
): Promise<{
  buffer: Buffer;
  mimeType: string;
  filename: string;
}> {
  const asset = await __mediaGetAsset(
    mediaId,
    userId
  );

  if (
    typeof (globalThis as any).__madeccExtractAudio !==
    "function"
  ) {
    throw new Error(
      "Audio extraction engine is not available."
    );
  }

  const extractAudio =
    (globalThis as any).__madeccExtractAudio;

  const inputUrl =
    asset.storageUrl;

  if (!inputUrl) {
    throw new Error(
      "Media asset does not have a storage URL."
    );
  }

  const response =
    await fetch(inputUrl);

  if (!response.ok) {
    throw new Error(
      `Unable to download source media (${response.status}).`
    );
  }

  const arrayBuffer =
    await response.arrayBuffer();

  const tempDir =
    await import("node:os");

  const fs =
    await import("node:fs/promises");

  const path =
    await import("node:path");

  const dir =
    await fs.mkdtemp(
      path.join(
        tempDir.tmpdir(),
        "madecc-media-"
      )
    );

  const input =
    path.join(
      dir,
      `input.${asset.extension || "bin"}`
    );

  const output =
    path.join(
      dir,
      `output.${format}`
    );

  try {
    await fs.writeFile(
      input,
      Buffer.from(arrayBuffer)
    );

    await extractAudio(
      input,
      output,
      format
    );

    const buffer =
      await fs.readFile(output);

    return {
      buffer,
      mimeType:
        format === "mp3"
          ? "audio/mpeg"
          : "audio/wav",
      filename:
        `${__mediaSafeFilename(asset.name || "madecc-audio")}.${format}`,
    };
  }
  finally {
    await fs.rm(
      dir,
      {
        recursive: true,
        force: true,
      }
    );
  }
}
export async function archiveMedia(
  mediaId: string,
  userId: string
): Promise<void> {
  await __mediaGetAsset(
    mediaId,
    userId
  );

  await db
    .update(aiMediaAssets)
    .set({
      archived: true,
      updatedAt: new Date(),
    })
    .where(
      and(
        eq(aiMediaAssets.id, mediaId),
        eq(aiMediaAssets.userId, userId)
      )
    );
}





/**
 * Persist a generated AI media item into the MADECC
 * AI Media Library.
 */
export async function createMediaAsset(params: {
  userId: string;
  projectId?: string | null;
  jobId?: string | null;
  filepath?: string | null;
  filename: string;
  mimeType: string;
  storageUrl?: string | null;
  metadata?: Record<string, unknown> | null;
}) {
  const {
    userId,
    projectId = null,
    jobId = null,
    filepath = null,
    filename,
    mimeType,
    storageUrl = null,
    metadata = null,
  } = params;

  if (!userId) {
    throw new Error("createMediaAsset requires userId.");
  }

  if (!filename) {
    throw new Error("createMediaAsset requires filename.");
  }

  if (!mimeType) {
    throw new Error("createMediaAsset requires mimeType.");
  }

  const extension = filename.includes(".")
    ? filename.substring(filename.lastIndexOf(".") + 1).toLowerCase()
    : "";

  let mediaType:
    | "video"
    | "audio"
    | "image"
    | "text"
    | "document"
    | "file";

  if (mimeType.startsWith("video/")) {
    mediaType = "video";
  }
  else if (mimeType.startsWith("audio/")) {
    mediaType = "audio";
  }
  else if (mimeType.startsWith("image/")) {
    mediaType = "image";
  }
  else if (mimeType.startsWith("text/")) {
    mediaType = "text";
  }
  else if (
    mimeType.includes("pdf") ||
    mimeType.includes("word") ||
    mimeType.includes("document")
  ) {
    mediaType = "document";
  }
  else {
    mediaType = "file";
  }

  let sizeBytes: number | null = null;

  if (filepath) {
    try {
      const fs = await import("node:fs/promises");
      const stat = await fs.stat(filepath);
      sizeBytes = stat.size;
    }
    catch {
      sizeBytes = null;
    }
  }

  const name = filename.includes(".")
    ? filename.substring(0, filename.lastIndexOf("."))
    : filename;

  const [asset] = await db
    .insert(aiMediaAssets)
    .values({
      userId,
      projectId,
      jobId,
      name,
      originalFilename: filename,
      mediaType,
      mimeType,
      extension,
      sizeBytes,
      storageUrl,
      metadata,
      status: "ready",
      archived: false,
    })
    .returning();

  if (!asset) {
    throw new Error(
      "Unable to create MADECC AI media asset."
    );
  }

  return asset;
}

/**
 * Finalize AI-generated media into the MADECC Media Library.
 *
 * AI Provider
 *      ↓
 * Generated media
 *      ↓
 * Cloudinary / storage
 *      ↓
 * createMediaAsset()
 *      ↓
 * ai_media_assets
 *      ↓
 * Media Library
 */
export async function finalizeGeneratedMedia(params: {
  userId: string;
  projectId?: string | null;
  jobId?: string | null;

  filepath?: string | null;

  filename: string;

  mimeType: string;

  storageUrl?: string | null;

  prompt?: string | null;

  provider?: string | null;

  model?: string | null;

  source?: string | null;

  contentType?: string | null;

  metadata?: Record<string, unknown> | null;
}) {

  const asset = await createMediaAsset({
    userId: params.userId,

    projectId:
      params.projectId ?? null,

    jobId:
      params.jobId ?? null,

    filepath:
      params.filepath ?? null,

    filename:
      params.filename,

    mimeType:
      params.mimeType,

    storageUrl:
      params.storageUrl ?? null,

    metadata: {
      source:
        params.source ??
        "ai-generation",

      prompt:
        params.prompt ??
        null,

      provider:
        params.provider ??
        null,

      model:
        params.model ??
        null,

      contentType:
        params.contentType ??
        null,

      ...(params.metadata ?? {}),
    },
  });

  return {
    id: asset.id,

    name: asset.name,

    mediaType:
      asset.mediaType,

    mimeType:
      asset.mimeType,

    downloadUrl:
      `/api/ai/media/${asset.id}/download`,

    asset,
  };
}

