/* =========================================================
   DOWNLOAD TEXT MEDIA
========================================================= */

router.get(
  "/media/:id/download",
  async (
    req,
    res
  ) => {
    try {
      const userId =
        getUserId(req);

      const rows =
        await db
          .select()
          .from(aiMedia)
          .where(
            eq(
              aiMedia.id,
              req.params.id
            )
          )
          .limit(1);

      const media =
        rows[0];

      if (
        !media ||
        media.userId !== userId
      ) {
        return res
          .status(404)
          .json({
            success: false,
            message:
              "Media not found.",
          });
      }

      if (
        media.url
      ) {
        return res.redirect(
          media.url
        );
      }

      const text =
        media.textContent ||
        "";

      res.setHeader(
        "Content-Type",
        media.mimeType ||
          "text/plain"
      );

      res.setHeader(
        "Content-Disposition",
        `attachment; filename="${media.name}"`
      );

      return res.send(
        text
      );
    } catch (error) {
      return res
        .status(500)
        .json({
          success: false,
          message:
            "Download failed.",
        });
    }
  }
);

